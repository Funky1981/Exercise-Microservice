{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start App",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-ExerciseDev.ps1",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rebuild API",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-ExerciseDev.ps1 -Rebuild",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rebuild All + Sync",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-ExerciseDev.ps1 -RebuildAll -RunSync",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Local API",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\Start-ExerciseDev.ps1 -StartApiLocally -SkipDocker",
            "cwd": "${workspaceFolder}"
        }
    ]
}
